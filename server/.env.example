# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB Atlas or Local MongoDB)
# For Atlas, replace with your connection string: mongodb+srv://<user>:<password>@cluster.mongodb.net/skillforge?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/skillforge

# JWT Configuration
JWT_SECRET=skillforge_super_secure_jwt_secret_key_2026_dev
JWT_EXPIRES_IN=7d

# Client Configuration
CLIENT_URL=http://localhost:5173
